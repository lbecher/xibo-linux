#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
BUILD_DIR := debian/build

%:
	dh $@ --buildsystem=cmake --sourcedirectory=player --builddirectory=$(BUILD_DIR)

override_dh_auto_configure:
	dh_auto_configure --builddirectory=$(BUILD_DIR) -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_install:
	dh_auto_configure --builddirectory=$(BUILD_DIR) -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	dh_auto_build --builddirectory=$(BUILD_DIR)
	dh_auto_install --builddirectory=$(BUILD_DIR) --destdir=debian/tmp

override_dh_clean:
	# Evita varrer toda a arvore (incluindo dados locais de Docker sem permissao).
	dh_clean -d
